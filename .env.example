# Variables del servidor. En Vercel se cargan en Settings > Environment Variables.
# Para desarrollo local podés copiar este archivo a .env (sin estas variables usa SQLite y disco local).

# Supabase > Connect > "Transaction pooler" (puerto 6543), con tu clave de base de datos
DATABASE_URL=postgresql://postgres.xxxxxxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API: URL del proyecto y clave secreta (sb_secret_... o service_role)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Texto largo al azar. Cifra las claves de las cámaras: no lo cambies ni lo pierdas.
SECRET_KEY=

# Clave del usuario "admin" que se crea la primera vez
ADMIN_PASSWORD=

# Protege la limpieza diaria (Vercel la manda sola). Texto al azar.
CRON_SECRET=

# Opcionales
TELEGRAM_BOT_TOKEN=
RETENTION_DAYS=60
# PUBLIC_URL=https://vigia.tuempresa.com   (si usás un dominio propio)
